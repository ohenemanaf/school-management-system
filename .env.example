# Generate real values using node scripts/configure-deployment.cjs --email YOUR_EMAIL
APP_BIND=127.0.0.1
APP_PORT=8080
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional: needed only for compose.https.yaml
SITE_DOMAIN=
# Optional email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender shown on emails, e.g. "School Name" <no-reply@yourschool.edu>
SMTP_FROM=
# Set to false to stop anyone creating a student account from the login page
ALLOW_PUBLIC_REGISTRATION=true
# School time zone, used for attendance dates
TZ=Africa/Accra
