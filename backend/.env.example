NODE_ENV=development
PORT=5000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=school_system
JWT_SECRET=replace-with-a-long-random-local-secret
# Optional SMTP settings
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Set to false to stop anyone creating a student account from the login page
ALLOW_PUBLIC_REGISTRATION=true

# Only used by npm run seed; choose unique bootstrap credentials locally
ADMIN_EMAIL=
ADMIN_PASSWORD=
